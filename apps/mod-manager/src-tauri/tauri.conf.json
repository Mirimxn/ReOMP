{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReOMP Mod Manager",
  "version": "0.10.2",
  "identifier": "com.reomp.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReOMP Mod Manager",
        "width": 1000,
        "height": 700,
        "label": "main"
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
