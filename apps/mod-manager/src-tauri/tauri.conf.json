{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReOMP Mod Manager",
  "version": "0.1.0",
  "identifier": "com.reomp.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReOMP Mod Manager",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
